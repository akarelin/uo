    rdfs:comment "Wikidata Q380 is the company, since renamed Meta Platforms."@en ;
    owl:sameAs wd:Q380 ;
    skos:prefLabel "Facebook" ;
    uo:assertedIn uo:checkpoint-2026-08-21T03-57-PDT .

