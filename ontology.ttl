    owl:sameAs wd:Q4778915 ;
    skos:prefLabel "Cloudflare" ;
    uo:assertedIn uo:checkpoint-2026-08-21T03-57-PDT .

uo:Conversation a owl:Class ;
    rdfs:label "Conversation"@en ;
    rdfs:subClassOf obo:IAO_0000030 .

uo:Created a uo:LifecycleEventType ;
    skos:prefLabel "created"@en ;
    uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:Curated a uo:LifecycleEventType ;
    skos:prefLabel "curated"@en ;
    uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:Epoch a owl:Class ;
    rdfs:label "epoch"@en .

