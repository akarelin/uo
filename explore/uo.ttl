# Checkpoint 3 — 04:25 PDT
############################

uo:checkpoint-2026-08-21T04-25-PDT
  a uo:MemoryCheckpoint ;
  dct:title "Ontology Term Matching"@en ;
  prov:generatedAtTime "2026-08-21T04:25:00-07:00"^^xsd:dateTime ;
  uo:contains uo:Epoch19,
              uo:Epoch19OntologyResearch,
              uo:UndatedJournalSegmentAfter2025-12-10Through2026-01-16,
              uo:UndatedEventsAfter2025-12-10Through2026-01-16,
              uo:AnnusMirabilis,
              uo:RecursiveGenerativePrompting,
              uo:AbsenceOfCrisis .

uo:Epoch19 a uo:Epoch ;
  skos:prefLabel "Epoch 19"@en ;
  dct:identifier "19" ;
  dct:hasPart uo:Epoch19OntologyResearch ;
  uo:hasAssociatedLabel uo:AnnusMirabilis,
                        uo:RecursiveGenerativePrompting ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:Epoch19OntologyResearch a uo:OntologyResearchEpisode ;
  skos:prefLabel "ontology research"@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:IntervalAfter2025-12-10Through2026-01-16
  a time:ProperInterval ;
  rdfs:label "after 2025-12-10 through 2026-01-16"@en ;
  uo:intervalStartExclusive "2025-12-10"^^xsd:date ;
  uo:intervalEndInclusive "2026-01-16"^^xsd:date ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:UndatedJournalSegmentAfter2025-12-10Through2026-01-16
  a uo:JournalSegment ;
  rdfs:label "undated journal segment after 2025-12-10 through 2026-01-16"@en ;
  uo:temporalCoverage uo:IntervalAfter2025-12-10Through2026-01-16 ;
  uo:hasAssociatedLabel uo:AnnusMirabilis,
                        uo:RecursiveGenerativePrompting ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:UndatedEventsAfter2025-12-10Through2026-01-16
  a uo:UndatedEventSet ;
  rdfs:label "undated events belonging to the journal interval"@en ;
  uo:withinTemporalSpan uo:IntervalAfter2025-12-10Through2026-01-16 ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:AnnusMirabilis a uo:TemporalLabel ;
  skos:prefLabel "Annus Mirabilis" ;
  rdfs:comment "Dictated as 'Anis Mirabilis'."@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:RecursiveGenerativePrompting a uo:TemporalLabel ;
  skos:prefLabel "Recursive generative prompting" ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .

uo:AbsenceOfCrisis a uo:Slogan ;
  rdf:value "Absence of crisis" ;
  dct:date "2025-12-10"^^xsd:date ;
  dct:isPartOf uo:Epoch19 ;
  uo:assertedIn uo:checkpoint-2026-08-21T04-25-PDT .


# ══════════════════ src/properties.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Object properties
# ─────────────────────────────────────────────────────────────────────────────

uo:tags a owl:DatatypeProperty ;
    rdfs:label   "tags"@en ;
    rdfs:comment "Free-text keyword tags."@en ;
    rdfs:domain  uo:Entity ;
    rdfs:range   xsd:string .


uo:description a owl:DatatypeProperty ;
    uo:fieldName "description" ;
    rdfs:label   "description"@en ;
    rdfs:comment "Free-text description of the entity. On ontology term pages it mirrors the term's rdfs:comment and round-trips via sync."@en ;
    rdfs:domain  uo:Entity ;
    rdfs:range   xsd:string .

uo:status a owl:ObjectProperty ;
    rdfs:label   "status"@en ;
    rdfs:comment "Lifecycle status. Constrained vocabulary (uo:Status)."@en ;
    rdfs:domain  uo:Entity ;
    rdfs:range   uo:Status .



# ── Navigation relations (Breadcrumbs: up/down hierarchy, prev/next sequence) ──

uo:up a owl:ObjectProperty ;
    rdfs:label    "up"@en ;
    rdfs:comment  "Hierarchical parent: the broader entity this one sits under."@en ;
    rdfs:domain   uo:Thread ;
    rdfs:range    uo:Thread ;
    owl:inverseOf uo:down .

uo:down a owl:ObjectProperty ;
    rdfs:label    "down"@en ;
    rdfs:comment  "Hierarchical child: inverse of up."@en ;
    rdfs:domain   uo:Thread ;
    rdfs:range    uo:Thread .

uo:prev a owl:ObjectProperty ;
    rdfs:label    "prev"@en ;
    rdfs:comment  "Previous item in a sequence of entities."@en ;
    rdfs:domain   uo:Thread ;
    rdfs:range    uo:Thread ;
    owl:inverseOf uo:next .

uo:next a owl:ObjectProperty ;
    rdfs:label    "next"@en ;
    rdfs:comment  "Next item in a sequence of entities: inverse of prev."@en ;
    rdfs:domain   uo:Thread ;
    rdfs:range    uo:Thread .

# ── Org / axis relations ──

# uo:org a owl:ObjectProperty ;
#     rdfs:label   "org"@en ;
#     rdfs:comment "Organisation a person or Entity belongs to."@en ;
