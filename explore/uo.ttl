# Generated from src/*.ttl by explorer/scripts/generate-ontology-data.mjs.
# The source layers remain authoritative.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix uo: <https://uo.karelin.ai/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .


# ══════════════════ src/abstract.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# uo Domain Ontology — canonical TBox (schema only; instances live elsewhere)
# Source of truth: the UO/src/*.ttl folder. Edited in Obsidian → proposed back
# here via obsidian_to_ttl → committed to git.
# Compiled to consumers (Obsidian, Postgres, etc.) by ontology compiler.
# Layer = file: abstract.ttl / domain.ttl / vocabulary-*.ttl / properties.ttl
# ─────────────────────────────────────────────────────────────────────────────

uo: a owl:Ontology ;
    rdfs:label    "UO Domain Ontology"@en ;
    rdfs:comment  "Canonical schema for Alex's personal+work knowledge graph."@en ;
    owl:versionInfo "0.3.0" ;
    dct:created   "2026-08-21"^^xsd:date .


# ─────────────────────────────────────────────────────────────────────────────
# Annotation properties
# ─────────────────────────────────────────────────────────────────────────────

uo:abstract a owl:AnnotationProperty ;
    rdfs:label   "abstract"@en ;
    rdfs:comment "True when the class is an abstract name — never used as a type: value in frontmatter or in text; concrete subclasses carry the user-facing names."@en .

uo:typeName a owl:AnnotationProperty ;
    rdfs:label   "type name"@en ;
    rdfs:comment "The exact type: token and fileClass name for this class, when it differs from the label (e.g. Ontology Entity → OntologyEntity)."@en .

uo:fieldName a owl:AnnotationProperty ;
    rdfs:label   "field name"@en ;
    rdfs:comment "The exact Obsidian frontmatter key this property is stored as, when it differs from the snake_cased label (e.g. hasAxis → axis, alternateName → alternateName)."@en .


# ─────────────────────────────────────────────────────────────────────────────
# Abstract classes
# ─────────────────────────────────────────────────────────────────────────────

uo:Entity a owl:Class ;
    uo:abstract true ;
    rdfs:label   "Entity"@en ;
    rdfs:comment "Abstract base class for all named things in the graph."@en .

obo:IAO_0000030 a owl:Class ;
    uo:typeName "InformationContentEntity" ;
    uo:abstract true ;
    rdfs:label   "Information Content Entity"@en ;
    rdfs:comment "An information artifact that is about something — notes, messages, documents, transcripts, recordings. (IAO Information Content Entity; BFO Generically Dependent Continuant.)"@en .

uo:Ontology a owl:Class ;
    rdfs:subClassOf skos:Concept, prov:Entity ;
    rdfs:label   "Ontology"@en ;
    rdfs:comment "A formal, named namespace of terms (classes and properties) with a canonical IRI prefix."@en .

uo:OntologyEntity a owl:Class ;
    uo:typeName "OntologyEntity" ;
    rdfs:subClassOf skos:Concept, prov:Entity ;
    rdfs:label   "Ontology Entity"@en ;
    rdfs:comment "A class term defined within a specific Ontology — e.g. Thread, Role, prov:Entity, skos:Concept. Attributes (e.g. phone, participants) are uo:Property, not OntologyEntity. References its parent Ontology via inOntology."@en .

uo:Property a owl:Class ;
    rdfs:subClassOf skos:Concept, prov:Entity ;
    rdfs:label   "Property"@en ;
    rdfs:comment "An attribute or relation defined within an Ontology — e.g. phone, participants, up. Distinct from OntologyEntity (class terms)."@en .

uo:Thread a owl:Class ;
    rdfs:subClassOf uo:Entity, obo:IAO_0000030, prov:Activity ;
    uo:abstract true ;
    rdfs:label   "Thread"@en ;
    rdfs:comment "Abstract name for a connected sequence of work items — like up/down/prev/next for edges, the abstract name is never used in text or frontmatter; renderings are Project, Epic, Task, Idea, sites visited, etc. Threads are semantic, more like annotations; contrast uo:Activity, which is grounded in real data."@en .

uo:Chain a owl:Class ;
    owl:equivalentClass uo:Thread ;
    owl:deprecated true ;
    rdfs:label   "Chain"@en ;
    rdfs:comment "Deprecated synonym of Thread (deprecated 2026-07-29)."@en .

uo:Activity a owl:Class ;
    rdfs:subClassOf uo:Entity ;
    rdfs:label   "Activity"@en ;
    rdfs:comment "A timespan or event on the timeline, based on real data (LLM logs, chats, etc.). Overlaps with Thread but not exactly: Threads are semantic annotations; Activities are real-data timespans."@en .

skos:ConceptScheme a owl:Class ;
    rdfs:label   "Scheme"@en ;
    rdfs:comment "A controlled vocabulary: the set of allowed values for a typed frontmatter field. Members are SKOS Concepts that point back via inScheme."@en .

uo:Dimension a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label   "Dimension"@en ;
    rdfs:comment "A classifier value attached to work items — the value of a dimension field (e.g. Xsolla, AI). A SKOS concept; the vocabularies that hold dimension values are Schemes (skos:ConceptScheme — Axis, Theme, Grouping)."@en .


# ══════════════════ src/domain.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Domain classes
# ─────────────────────────────────────────────────────────────────────────────

uo:Concept a owl:Class ;
    rdfs:subClassOf uo:Entity, skos:Concept ;
    rdfs:label   "Concept"@en ;
    rdfs:comment "An abstract topic, framework, or domain (e.g. Ontology, Compliance)."@en .

uo:Platform a owl:Class ;
    rdfs:subClassOf uo:Entity, prov:Entity ;
    rdfs:label   "Platform"@en ;
    rdfs:comment "A tool, SaaS service, or piece of infrastructure."@en .


# ── People & organisations ──

prov:Person a owl:Class ;
    rdfs:subClassOf uo:Entity ;
    rdfs:label   "Person"@en ;
    rdfs:comment "A human individual."@en .

prov:Organization a owl:Class ;
    rdfs:subClassOf uo:Entity ;
    rdfs:label   "Org"@en ;
    rdfs:comment "An organisation (company, team, legal entity)."@en .

prov:Location a owl:Class ;
    rdfs:subClassOf uo:Entity ;
    rdfs:label   "Place"@en ;
    rdfs:comment "A geographic location (city, office, region)."@en .

uo:Role a owl:Class ;
    rdfs:subClassOf uo:Entity ;
    rdfs:label   "Role"@en ;
    rdfs:comment "A role someone plays inside an org or project."@en .


# ── Work — renderings of Thread ──

uo:Project a owl:Class ;
    rdfs:subClassOf uo:Entity, uo:Thread ;
    rdfs:label   "Project"@en ;
    rdfs:comment "An initiative with status, owner, and one or more axes. (BFO Process; PROV Activity via Thread.)"@en .

uo:Conversation a owl:Class ;
    rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label   "Conversation"@en .

uo:LLMChat a owl:Class ;
    rdfs:subClassOf uo:Conversation ;
    rdfs:label   "LLM-Chat"@en .

uo:Task a owl:Class ;
    rdfs:subClassOf uo:Thread ;
    rdfs:label   "Task"@en .

uo:Idea a owl:Class ;
    rdfs:subClassOf uo:Thread ;
    rdfs:label   "Idea"@en .

uo:Ongoing a owl:Class ;
    rdfs:subClassOf uo:Entity ;
    owl:deprecated true ;
    rdfs:label   "Ongoing"@en ;
    rdfs:comment "Deprecated page schema; ongoing-ness is lifecycle/status, not schema."@en .

uo:Epic a owl:Class ;
    rdfs:subClassOf uo:Thread ;
    rdfs:label   "Epic"@en .

# uo:Dashboard a owl:Class ;
#     rdfs:subClassOf obo:IAO_0000030 ;
#     rdfs:label   "Dashboard"@en ;
#     rdfs:comment "A page whose content is rendered dynamically by a view — frontmatter plus a view reference, no hand-written body."@en .

uo:ProjectFile a owl:Class ;
    uo:typeName "ProjectFile" ;
    rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label   "Project File"@en ;
    rdfs:comment "A piece of textual content (notes, sections, attachments) belonging to a Project, Epic, Idea, or Task page, co-located with its parent file."@en .


# ── Real-world organisations — an Organization can itself be a Dimension
#    (filter knowledge related to the organization); their scheme membership is
#    asserted in vocabulary-axis.ttl / vocabulary-grouping.ttl ──

uo:Xsolla   a prov:Organization ; rdfs:label "Xsolla"@en   ; owl:sameAs wd:Q4053407 .
uo:TulaCo   a prov:Organization ; rdfs:label "TulaCo"@en .
uo:SunTrust a prov:Organization ; rdfs:label "SunTrust"@en ; owl:sameAs wd:Q181507 .


# ══════════════════ src/vocabulary-axis.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Axis vocabulary — the Scheme and its Dimension values (populated from the
# `axis:` frontmatter field across the Obsidian vault)
# Each value is a uo:Dimension and declares its vocabulary via skos:inScheme uo:Axis.
# An Organization can itself be a Dimension (filter knowledge related to the
# organization): Xsolla, TulaCo, SunTrust are the prov:Organization individuals
# declared in domain.ttl, additionally typed uo:Dimension here. Their Grouping
# membership is asserted in vocabulary-grouping.ttl.
# ─────────────────────────────────────────────────────────────────────────────

uo:Axis a skos:ConceptScheme ;
    rdfs:label   "Axis"@en ;
    rdfs:comment "Controlled vocabulary of axis dimension-values."@en .

uo:SmartHome a uo:Dimension ; rdfs:label "SmartHome"@en ; skos:notation "SmartHome" ;
    skos:inScheme uo:Axis .
uo:Creekview a uo:Dimension ; rdfs:label "Creekview"@en ; skos:notation "Creekview" ;
    skos:inScheme uo:Axis .
uo:Data      a uo:Dimension ; rdfs:label "Data"@en      ; skos:notation "Data" ;
    skos:inScheme uo:Axis .
uo:AI        a uo:Dimension ; rdfs:label "AI"@en        ; skos:notation "AI" ;
    skos:inScheme uo:Axis .
uo:Karelin   a uo:Dimension ; rdfs:label "Karelin"@en   ; skos:notation "Karelin" ;
    rdfs:comment "Personal/meta axis — Alex Karelin's own domain and cross-cutting work."@en ;
    skos:inScheme uo:Axis .

# Axis values that are real-world Orgs (declared in domain.ttl)
uo:Xsolla    a uo:Dimension ; skos:notation "Xsolla" ;
    skos:inScheme uo:Axis .
uo:TulaCo    a uo:Dimension ; skos:notation "TulaCo" ;
    skos:inScheme uo:Axis .
uo:SunTrust  a uo:Dimension ; skos:notation "Suntrust" ;
    skos:inScheme uo:Axis .


# ══════════════════ src/vocabulary-grouping.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Grouping vocabulary — the Scheme and its values (populated from the
# KG/Grouping/ instances and the `grouping:` field). Organizations that are
# also Axis values (Xsolla, TulaCo, SunTrust) are the same IRIs — one concept,
# member of both schemes.
# ─────────────────────────────────────────────────────────────────────────────

uo:Grouping a skos:ConceptScheme ;
    rdfs:label   "Grouping"@en ;
    rdfs:comment "Controlled vocabulary of grouping dimension-values (top-level domains projects sit under)."@en .

# Orgs declared in domain.ttl, typed uo:Dimension in vocabulary-axis.ttl
uo:Xsolla   skos:inScheme uo:Grouping .
uo:TulaCo   skos:inScheme uo:Grouping .
uo:SunTrust skos:inScheme uo:Grouping .

uo:Thinking     a uo:Dimension ; rdfs:label "Thinking"@en     ; skos:notation "Thinking" ;
    skos:inScheme uo:Grouping .
uo:Productivity a uo:Dimension ; rdfs:label "Productivity"@en ; skos:notation "Productivity" ;
    skos:inScheme uo:Grouping .
uo:Work         a uo:Dimension ; rdfs:label "Work"@en         ; skos:notation "Work" ;
    skos:inScheme uo:Grouping .


# ══════════════════ src/vocabulary-process.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Process vocabulary — class only; phase/element values not yet promoted
# (canonical 7 bold items live in Concepts/Process.md; promote when decided)
# ─────────────────────────────────────────────────────────────────────────────

uo:Process a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme, skos:Concept ;
    rdfs:label   "Process"@en ;
    rdfs:comment "A node in a work-lifecycle scheme — phases (Start, Scope, Pre-production, Production, Result) and the entities recognised within them."@en .


# ══════════════════ src/vocabulary-source.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Source vocabulary — class and values (backfilled from KG)
# ─────────────────────────────────────────────────────────────────────────────

uo:Source a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme, skos:Concept ;
    rdfs:label   "Source"@en ;
    rdfs:comment "Provenance of an entity record — how it was captured into the graph. Closed vocabulary (backfilled from KG source: field)."@en .

uo:SessionIntelSource a uo:Source ; rdfs:label "session-intel"@en ; skos:notation "session-intel" ; skos:inScheme uo:Source .
uo:AlexSource         a uo:Source ; rdfs:label "alex"@en          ; skos:notation "alex"          ; skos:inScheme uo:Source .


# ══════════════════ src/vocabulary-status.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Status vocabulary — class and values (backfilled from KG)
# ─────────────────────────────────────────────────────────────────────────────

uo:Status a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme, skos:Concept ;
    rdfs:label   "Status"@en ;
    rdfs:comment "Lifecycle status of a project. Closed vocabulary (backfilled from KG status: field)."@en .

uo:ActiveStatus   a uo:Status ; rdfs:label "active"@en   ; skos:notation "active"   ; skos:inScheme uo:Status .
uo:ArchivedStatus a uo:Status ; rdfs:label "archived"@en ; skos:notation "archived" ; skos:inScheme uo:Status .
uo:RetiredStatus     a uo:Status ; rdfs:label "retired"@en     ; skos:notation "retired"     ; skos:inScheme uo:Status .
uo:SupersededStatus  a uo:Status ; rdfs:label "superseded"@en  ; skos:notation "superseded"  ; skos:inScheme uo:Status .


# ══════════════════ src/vocabulary-theme.ttl ══════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Theme vocabulary — the Scheme. Values not yet promoted from prose
# (canonical list lives in Concepts/Themes.md: Hermes / Inventory and timeline /
# KDT); promote here when decided.
# ─────────────────────────────────────────────────────────────────────────────

uo:Theme a skos:ConceptScheme ;
    rdfs:label   "Theme"@en ;
    rdfs:comment "Controlled vocabulary of theme dimension-values."@en .


# ══════════════════ src/voiceinteractive-last-3-memories.ttl ══════════════════

uo:voiceinteractive-memory-import
  a owl:Ontology ;
  dct:title "Last three Voice Interactive memory checkpoints"@en ;
  dct:created "2026-08-21"^^xsd:date ;
  dct:description "Structured from the available Voice Interactive memory context; not a verbatim transcript. Migrated from the urn:alex:kg: namespace into UO; dictation artefacts resolved (dictated forms noted in comments)."@en ;
  owl:imports <http://www.w3.org/2004/02/skos/core>,
              <http://www.w3.org/ns/prov-o>,
              <http://www.w3.org/2006/time> .

##########
# Schema — classes and properties not already defined in abstract.ttl /
# domain.ttl / properties.ttl. Person, Org, Role, ProjectFile, and
# InformationContentEntity reuse prov:Person, prov:Organization, uo:Role,
# uo:ProjectFile, obo:IAO_0000030; technology terms reuse uo:Platform.
##########

uo:MemoryCheckpoint a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "memory checkpoint"@en .

uo:Specification a owl:Class ;
  rdfs:subClassOf obo:IAO_0000030 ;
  rdfs:label "specification"@en ;
  skos:altLabel "spec"@en .

uo:LifecycleEventType a owl:Class ;
  rdfs:label "lifecycle event type"@en .

uo:LifecycleState a owl:Class ;
  rdfs:label "lifecycle state"@en .

uo:RoleAssignment a owl:Class ;
  rdfs:label "role assignment"@en .

uo:Epoch a owl:Class ;
  rdfs:label "epoch"@en .

uo:JournalSegment a owl:Class ;
  rdfs:subClassOf obo:IAO_0000030 ;
  rdfs:label "journal segment"@en .

uo:UndatedEventSet a owl:Class ;
  rdfs:label "undated event set"@en .

uo:OntologyResearchEpisode a owl:Class ;
  rdfs:label "ontology research episode"@en .

uo:TemporalLabel a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "temporal label"@en .

uo:Slogan a owl:Class ;
  rdfs:subClassOf obo:IAO_0000030 ;
  rdfs:label "slogan"@en .

uo:contains a owl:ObjectProperty ;
  rdfs:domain uo:MemoryCheckpoint .

uo:assertedIn a owl:ObjectProperty ;
  rdfs:range uo:MemoryCheckpoint .

uo:hasLifecycleEventType a owl:ObjectProperty ;
  rdfs:domain obo:IAO_0000030 ;
  rdfs:range uo:LifecycleEventType .

uo:mayHaveLifecycleState a owl:ObjectProperty ;
  rdfs:domain obo:IAO_0000030 ;
  rdfs:range uo:LifecycleState .

uo:person a owl:ObjectProperty ;
  rdfs:domain uo:RoleAssignment ;
  rdfs:range prov:Person .

uo:organization a owl:ObjectProperty ;
  rdfs:domain uo:RoleAssignment ;
  rdfs:range prov:Organization .

uo:role a owl:ObjectProperty ;
  rdfs:domain uo:RoleAssignment ;
  rdfs:range uo:Role .

uo:possibleAliasOf a owl:ObjectProperty ;
  rdfs:label "possible alias of"@en .

uo:currentName a owl:DatatypeProperty ;
  rdfs:range xsd:string .

uo:canonicalShortName a owl:DatatypeProperty ;
  rdfs:range xsd:string .

uo:temporalCoverage a owl:ObjectProperty ;
  rdfs:range time:ProperInterval .

uo:withinTemporalSpan a owl:ObjectProperty ;
  rdfs:range time:ProperInterval .

uo:hasAssociatedLabel a owl:ObjectProperty ;
  rdfs:range uo:TemporalLabel .

uo:intervalStartExclusive a owl:DatatypeProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range xsd:date .

uo:intervalEndInclusive a owl:DatatypeProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range xsd:date .

uo:nextTopic a owl:DatatypeProperty ;
  rdfs:range xsd:string .

uo:uncertainAssertion a owl:DatatypeProperty ;
  rdfs:range xsd:string .

