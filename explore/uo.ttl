uo:checkpoint-2026-08-21T02-11-PDT
  a uo:MemoryCheckpoint ;
  dct:title "Glossary Memory Session"@en ;
  prov:generatedAtTime "2026-08-21T02:11:00-07:00"^^xsd:dateTime ;
  uo:contains uo:ProjectFile,
              uo:Created,
              uo:Curated,
              uo:Verified,
              uo:Maintained,
              uo:Xsolla,
              uo:TulaCo,
              uo:Alex,
              uo:AlexTulacoManagingMember,
              uo:Axis ;
  uo:uncertainAssertion "A dictated statement associated person with organization and said that association was not required; its intended predicate or cardinality was not clear enough to formalize."@en .

uo:ProjectFile uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:Created a uo:LifecycleEventType ;
  skos:prefLabel "created"@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:Curated a uo:LifecycleEventType ;
  skos:prefLabel "curated"@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:Verified a uo:LifecycleEventType ;
  skos:prefLabel "verified"@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:Maintained a uo:LifecycleState ;
  skos:prefLabel "maintained"@en ;
  rdfs:comment "A lifecycle state for a created or curated information content entity."@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

# uo:Xsolla, uo:TulaCo, uo:SunTrust are declared prov:Organization (with their
# Wikidata owl:sameAs links) in domain.ttl.
