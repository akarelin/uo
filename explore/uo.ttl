  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:TulaCo skos:prefLabel "TulaCo" ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT,
                uo:checkpoint-2026-08-21T03-57-PDT .

uo:Alex a prov:Person ;
  uo:canonicalShortName "Alex" ;
  skos:prefLabel "Alex" ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:ManagingMember a uo:Role ;
  skos:prefLabel "managing member"@en ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

uo:AlexTulacoManagingMember a uo:RoleAssignment ;
  uo:person uo:Alex ;
  uo:organization uo:TulaCo ;
  uo:role uo:ManagingMember ;
  uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

# Dictated as 'accesses'; resolved to the Axis vocabulary term (Axes/Axis).
# uo:Axis is declared in vocabulary-axis.ttl.
uo:Axis uo:assertedIn uo:checkpoint-2026-08-21T02-11-PDT .

